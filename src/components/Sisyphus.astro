<sisyphus-scene>
  <canvas width="1120" height="520" role="img" aria-label="An ASCII landscape: Sisyphus pushes a boulder up a mountain. It rolls back down, and he begins again."></canvas>
</sisyphus-scene>

<script>
  import { mountSisyphus } from '../scripts/sisyphus';
  class SisyphusScene extends HTMLElement {
    private cleanup?: () => void;
    connectedCallback() { this.cleanup = mountSisyphus(this); }
    disconnectedCallback() { this.cleanup?.(); }
  }
  if (!customElements.get('sisyphus-scene')) customElements.define('sisyphus-scene', SisyphusScene);
</script>

<style>
  sisyphus-scene { display: block; position: relative; width: 100%; height: 100svh; height: 100dvh; overflow: clip; }
  canvas { display: block; width: 100%; height: 100%; }
</style>
